{
    "name": "markxp/security-hardening",
    "description": "Secures the WordPress site systematically against data leaks, scraper bots, and username enumeration.",
    "type": "wordpress-plugin",
    "license": "MIT",
    "authors": [
        {
            "name": "markxp"
        }
    ],
    "require": {
        "php": ">=8.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^13",
        "brain/monkey": "^2.6",
        "mockery/mockery": "^1.6",
        "laravel/pint": "^1.27"
    },
    "autoload": {
        "psr-4": {
            "SecurityHardening\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SecurityHardening\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "lint": "pint --test",
        "lint:fix": "pint",
        "build:dist": "bash bin/build-dist.sh"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
